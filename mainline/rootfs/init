#!/bin/sh
# Modern overlayfs needs separate upper/work directories on the same tmpfs.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export MIZY=1 INITRAMFS=1
mount -t proc proc /proc
mount -t devtmpfs devtmpfs /dev
mount -t sysfs sysfs /sys
mount -t tmpfs tmp /mnt
mkdir -p /mnt/rom /mnt/store /mnt/root
mount -t squashfs -o ro /dev/ram0 /mnt/rom || exec /bin/sh
mount -t tmpfs tmp-overlay /mnt/store
mkdir -p /mnt/store/upper /mnt/store/work
mount -t overlay overlay -o lowerdir=/mnt/rom,upperdir=/mnt/store/upper,workdir=/mnt/store/work /mnt/root || exec /bin/sh
mkdir -p /mnt/root/rom /mnt/root/overlay /mnt/root/mnt/store
mount -o bind /mnt/store/upper /mnt/root/overlay
mount -o move /mnt/rom /mnt/root/rom
mount -o move /mnt/store /mnt/root/mnt/store
for fs in proc sys dev; do mount -o move /$fs /mnt/root/$fs; done
exec switch_root /mnt/root /sbin/init.openwrt
